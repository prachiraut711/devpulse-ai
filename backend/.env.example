# DevPulse AI - Backend Environment Configuration Example
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env or expose real tokens to source control!

# ==============================================================================
# 1. LOCAL DEVELOPMENT CONFIGURATION (Without Docker)
# ==============================================================================
# When running backend locally via `uvicorn app.main:app --reload` on host machine:
#
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devpulse
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/devpulse-ai.private-key.pem
# FRONTEND_URL=http://localhost:5173

# ==============================================================================
# 2. DOCKER COMPOSE CONFIGURATION (Step 13)
# ==============================================================================
# When running with `docker compose up --build`:
# Backend communicates with postgres via container network name 'postgres:5432'.
# Private key is mounted into /app/secrets/devpulse-ai.private-key.pem:
#
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/devpulse
# GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/devpulse-ai.private-key.pem
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=devpulse

# ------------------------------------------------------------------------------
# GitHub App Configuration (Step 6 - Strictly Read-Only)
# ------------------------------------------------------------------------------
# Official GitHub App: DevPulse AI Platform (ID: 5118991)
GITHUB_APP_ID=5118991
GITHUB_APP_PRIVATE_KEY_PATH=secrets/devpulse-ai.private-key.pem

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Step 12 & Step 13)
# ------------------------------------------------------------------------------
# For host/local: postgresql+psycopg://postgres:postgres@localhost:5432/devpulse
# For docker-compose: postgresql+psycopg://postgres:postgres@postgres:5432/devpulse
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devpulse

# ------------------------------------------------------------------------------
# Gemini AI Configuration (Step 10 / 11)
# ------------------------------------------------------------------------------
# Google Gemini API key for PR reviews and deployment failure explanations.
# Never expose this key to the frontend or source control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Frontend & Application Settings
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
APP_ENV=development
DEBUG=True
PORT=8000

# ------------------------------------------------------------------------------
# Optional Legacy GitHub OAuth / PAT (Fallback)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
GITHUB_OAUTH_SCOPES=read:user repo
GITHUB_ACCESS_TOKEN=
